OPENAI_API_SPEECH_TEXT_KEY="change-me-to-your-key" #pragma: allowlist secret
OPENAI_API_KEY="change-me-to-your-key"                             # pragma: allowlist secret
# Local dev only: the API gateway that the Next.js /api/* rewrite forwards to.
# Without it the rewrite destination becomes "undefined/api/..." and every
# backend call (including the user-session lookup on "/") fails.
API_GATEWAY_HOST="http://localhost:8000"