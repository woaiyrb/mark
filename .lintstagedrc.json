{
  "*": ["yarn secrets:check:staged", "yarn format:staged"],
  "apps/api/**/*.ts": [
    "yarn --cwd apps/api test:staged",
    "yarn --cwd apps/api lint:staged"
  ],
  "apps/web/**/*.{ts,tsx}": ["yarn --cwd apps/web lint:staged"],
  "apps/api-gateway/**/*.ts": [
    "yarn --cwd apps/api-gateway test:staged",
    "yarn --cwd apps/api-gateway lint:staged"
  ],
  "Dockerfile": ["hadolint"],
  "*.{sh,zsh,bash}": ["shellcheck"]
}
